<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_destination_card"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:minHeight="52dp"
    android:background="@drawable/connecso_widget_destination_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="9dp"
    android:paddingVertical="5dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/widget_destination_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Netherlands"
            android:textColor="@color/widget_primary_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_destination_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="VLESS · XHTTP"
            android:textColor="@color/widget_secondary_text"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="›"
        android:textColor="@color/widget_accent"
        android:textSize="22sp"
        android:textStyle="bold" />
</LinearLayout>
