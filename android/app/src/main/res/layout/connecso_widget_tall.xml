<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/connecso_widget_background"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="12dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/widget_logo"
            android:layout_width="42dp"
            android:layout_height="48dp"
            android:contentDescription="Connecso"
            android:scaleType="fitCenter"
            android:src="@drawable/connecso_widget_logo_light" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widget_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ready to connect"
                android:textColor="@color/widget_primary_text"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Connecso"
                android:textColor="@color/widget_secondary_text"
                android:textSize="12sp" />
        </LinearLayout>
        <ImageView
            android:id="@+id/widget_action"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/connecso_widget_power_idle" android:scaleType="fitCenter" android:padding="11dp" android:src="@drawable/ic_widget_power" />
    </LinearLayout>
    <TextView
        android:id="@+id/widget_usage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="2dp"
        android:text="Used — / —"
        android:textColor="@color/widget_accent"
        android:textSize="13sp"
        android:textStyle="bold" />
    <ProgressBar
        android:id="@+id/widget_quota"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="4dp"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/widget_accent"
        android:progressBackgroundTint="@color/widget_progress_track" />
</LinearLayout>
