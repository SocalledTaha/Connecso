<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/connecso_widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">
    <ImageView
        android:id="@+id/widget_logo"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:contentDescription="Connecso"
        android:src="@drawable/connecso_widget_logo_light" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="8dp">
        <TextView
            android:id="@+id/widget_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Connected"
            android:textColor="@color/widget_primary_text"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Netherlands"
            android:textColor="@color/widget_secondary_text"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/widget_usage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingTop="2dp"
            android:text="Used — / —"
            android:textColor="@color/widget_accent"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
    <ImageView
        android:id="@+id/widget_action"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/connecso_widget_power_idle" android:scaleType="fitCenter" android:padding="11dp" android:src="@drawable/ic_widget_power" />
</LinearLayout>
