<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/connecso_widget_background"
    android:paddingHorizontal="7dp"
    android:paddingVertical="4dp">
    <ImageView
        android:id="@+id/widget_logo"
        android:layout_width="23dp"
        android:layout_height="30dp"
        android:contentDescription="Connecso"
        android:scaleType="fitCenter"
        android:src="@drawable/connecso_widget_logo_light" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="5dp"
        android:orientation="vertical">
        <TextView
            android:id="@+id/widget_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Connected"
            android:textColor="@color/widget_primary_text"
            android:textSize="10sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:text="Connecso"
            android:textColor="@color/widget_secondary_text"
            android:textSize="8sp" />
        <TextView
            android:id="@+id/widget_usage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Used — / —"
            android:textColor="@color/widget_accent"
            android:textSize="8sp"
            android:textStyle="bold" />
    </LinearLayout>
    <ImageView
        android:id="@+id/widget_action"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/connecso_widget_power_idle"
        android:padding="9dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_power" />
</LinearLayout>
