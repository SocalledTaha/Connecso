<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/connecso_widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingHorizontal="10dp"
    android:paddingVertical="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/widget_logo"
            android:layout_width="26dp"
            android:layout_height="32dp"
            android:contentDescription="Connecso"
            android:scaleType="fitCenter"
            android:src="@drawable/connecso_widget_logo_light" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widget_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Connected"
                android:textColor="@color/widget_primary_text"
                android:textSize="11sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:text="Connecso"
                android:textColor="@color/widget_secondary_text"
                android:textSize="9sp" />
        </LinearLayout>
        <ImageView
            android:id="@+id/widget_action"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/connecso_widget_power_idle"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_power" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_usage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Used — / —"
        android:textColor="@color/widget_accent"
        android:textSize="9sp"
        android:textStyle="bold" />
    <ProgressBar
        android:id="@+id/widget_quota"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="2dp"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/widget_accent"
        android:progressBackgroundTint="@color/widget_progress_track" />
</LinearLayout>
