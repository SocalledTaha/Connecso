<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/connecso_widget_background"
    android:padding="4dp">
    <TextView
        android:id="@+id/widget_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Connected"
        android:textColor="@color/widget_primary_text"
        android:textSize="9sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/widget_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Netherlands"
        android:textColor="@color/widget_secondary_text"
        android:textSize="8sp" />
    <ImageView
        android:id="@+id/widget_action"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginTop="2dp"
        android:background="@drawable/connecso_widget_power_idle"
        android:padding="9dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_power" />
    <TextView
        android:id="@+id/widget_usage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Used — / —"
        android:textColor="@color/widget_accent"
        android:textSize="7sp"
        android:textStyle="bold" />
    <ProgressBar
        android:id="@+id/widget_quota"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/widget_accent"
        android:progressBackgroundTint="@color/widget_progress_track" />
</LinearLayout>
